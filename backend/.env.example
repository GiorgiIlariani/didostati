# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/didostati

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Google Sign-In (OAuth client ID — Web client)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMS (optional — default is mock / console log in development)
# SMS_PROVIDER=mock
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# File Upload
MAX_FILE_SIZE=5242880
