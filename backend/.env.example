# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/didostati

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Google Sign-In (OAuth client ID — Web client)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMS — OTP delivery for phone login and checkout verification.
# Providers: mock | bulksms | smsoffice | twilio
#   mock      — codes are only printed to the server console (development).
#               In production the server REFUSES to start with mock unless
#               SMS_ALLOW_MOCK=true is set (tester-only deployments).
#   bulksms   — bulksms.ge (web.bulksms.ge → Account → API Keys → Generate,
#               Service: Bulksms). API docs: docs/PG365 SMS API v1.0.4 ENGLISH.odt
#               SMS_PROVIDER=bulksms
#               BULKSMS_PUBLIC_KEY=<Public Key from the panel>
#               BULKSMS_PRIVATE_KEY=<Private Key from the panel — long JWT-like string>
#               BULKSMS_ORIGINATOR=Didostati   (optional; must be a title
#                                               registered on the account.
#                                               Empty = account default title)
#               BULKSMS_API_URL=https://api.bulksms.ge   (optional, default)
#               NOTE: OTP texts are Georgian → ask the provider to enable
#               UNICODE encoding for the account, otherwise texts get garbled.
#   smsoffice — smsoffice.ge (Georgian provider). Buy credits, then set:
#               SMS_PROVIDER=smsoffice
#               SMSOFFICE_API_KEY=<key from your smsoffice.ge profile>
#               SMSOFFICE_SENDER=Didostati   (max 11 latin chars/digits)
#   twilio    — SMS_PROVIDER=twilio + TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
#               TWILIO_FROM_NUMBER (E.164, e.g. +1...)
SMS_PROVIDER=mock
# SMS_ALLOW_MOCK=true
# BULKSMS_PUBLIC_KEY=
# BULKSMS_PRIVATE_KEY=
# BULKSMS_ORIGINATOR=Didostati
# BULKSMS_API_URL=https://api.bulksms.ge
# SMSOFFICE_API_KEY=
# SMSOFFICE_SENDER=Didostati
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Store coordinates for GPS-based delivery fee (must match the frontend's
# NEXT_PUBLIC_DELIVERY_BASE_LAT / NEXT_PUBLIC_DELIVERY_BASE_LNG).
# DELIVERY_BASE_LAT=41.9842
# DELIVERY_BASE_LNG=44.1158

# File Upload
MAX_FILE_SIZE=5242880
